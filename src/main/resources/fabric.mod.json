  "authors": ["Hexamania"],
  "contact": {
    "homepage": "https://github.com/Hexamania/visualsfabric",
    "sources": "https://github.com/Hexamania/visualsfabric"
  },
  "license": "MIT",
  "icon": "assets/visualsfabric/icon.png",
  "environment": "client",
  "entrypoints": {
